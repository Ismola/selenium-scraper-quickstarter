// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "selenium-scrapper-quickstarter",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "ghcr.io/ismola/selenium-scraper-runtime:latest",
	"containerEnv": {
		"DOCKERIZED": "false",
		"HEADLESS_MODE": "auto",
		"CHROME_BIN": "/usr/bin/chromium",
		"CHROMEDRIVER_BIN": "/usr/bin/chromedriver",
		"FIREFOX_BIN": "/usr/bin/firefox-esr"
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4": {}
		// ,
		// "ghcr.io/devcontainers/features/python:1": {
		// 	"version": "latest"
		// }
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.autopep8",
				"donjayamanne.python-extension-pack",
				"ismola.ismola-extension-pack",
				"github.vscode-github-actions"
			]
			// ,
			// "settings": {
			// 	"python.terminal.activateEnvInCurrentTerminal": false,
			// 	"python.defaultInterpreterPath": "/usr/local/python/current/bin/python3"
			// }
		}
	},
	"containerUser": "root",
	"remoteUser": "root",
	"hostRequirements": {
		"cpus": 2,
		"memory": "8gb",
		"storage": "32gb"
	},
	"postCreateCommand": "pip install -r requirements.txt",
	// TODO: cambiar el nombre del contenedor y puerto
	// "appPort": 3000,
	"runArgs": [
		"--name",
		"selenium-scrapper-quickstarter",
		"--env",
		"TZ=Europe/Madrid"
		// ,"--network",
		// "sample-network"
	]
}
